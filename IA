      if(!lastPlan){ alert('Gere o plano e treine primeiro.'); return; }
      const raw = document.getElementById('values').value.trim();
      if(!raw){ alert('Informe valores, separados por vírgula.'); return; }
      const vals = raw.split(',').map(v => Number(v.trim()));
      const r = await fetch('/predict', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          domain: lastPlan.domain,
          task: lastPlan.task,
