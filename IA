      show('train', data.train);
      setStatus('pronto');
      if (lastPlan?.features){
        document.getElementById('feat-help').textContent =
          'Features do plano: ' + JSON.stringify(lastPlan.features);
      }
    }

    async function evolve(){
      if(!lastPlan){ alert('Gere o plano e treine primeiro.'); return; }
      const trials = parseInt(document.getElementById('trials').value || '8', 10);
      const r = await fetch('/evolve', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ plan: lastPlan, trials })
      });
      const data = await r.json();
      show('evolved', data);
