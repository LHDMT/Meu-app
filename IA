from fastapi import FastAPI
from fastapi.responses import HTMLResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel
from app.core.planner import infer_plan
from app.core.automl import train_initial, simple_evolve, predict

app = FastAPI(title="EvoIA - MVP")
app.mount("/static", StaticFiles(directory="app/static"), name="static")

# -------- Schemas --------
class BuildRequest(BaseModel):
    description: str

class EvolveRequest(BaseModel):
    plan: dict
    trials: int = 8

class PredictRequest(BaseModel):
    domain: str
    task: str
    features: list
    values: list

# -------- UI --------
@app.get("/", response_class=HTMLResponse)
def index():
    with open("app/templates/index.html", "r", encoding="utf-8") as f:
        return HTMLResponse(f.read())

# -------- API --------
@app.post("/build-ai")
def build_ai(req: BuildRequest):
    plan = infer_plan(req.description)
    train = train_initial(plan)
    return {"plan": plan, "train": train}

@app.post("/evolve")
def evolve(req: EvolveRequest):
    result = simple_evolve(req.plan, trials=req.trials)
    return {"evolved": result}

@app.post("/predict")
def do_predict(req: PredictRequest):
    out = predict(req.domain, req.task, req.features, req.values)
    return out
EOF

